{
  "name": "@kosa8/sdk",
  "version": "0.3.0",
  "description": "Typed TypeScript client for the kosa8 native API: microVM sandboxes for AI agents, with checkpoint, rewind, fork and explore.",
  "license": "MIT",
  "author": "kosa8",
  "homepage": "https://kosa8.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kosa8ai/kosa8-js.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/kosa8ai/kosa8-js/issues"
  },
  "keywords": [
    "kosa8",
    "sandbox",
    "microvm",
    "ai-agents",
    "agents",
    "code-execution",
    "isolation",
    "checkpoint",
    "fork",
    "egress",
    "sdk"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  }
}
